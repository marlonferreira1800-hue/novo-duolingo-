{
  "name": "medora-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src content tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ai:eval": "vitest run tests/ai",
    "ai:commit:dry": "node scripts/ai-git-agent.mjs --dry-run",
    "ai:commit": "node scripts/ai-git-agent.mjs --execute",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource/public-sans": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "1.65.0",
    "next": "16.4.6",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
