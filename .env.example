# Local development (npm run dev) enables the demo automatically.
# Explicitly enable only in a controlled review/preview environment.
# This does not mark medical content as reviewed or approved.
ENABLE_MEDICAL_DEMO=false

# Supabase (etapa 3). Never commit real values. Use Supabase local emulator for dev.
# Get these from: supabase start → shows API URL and keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: SERVER-SIDE ONLY (never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Public (browser-exposed) Supabase config — must mirror the values above
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI live provider (D5) — SERVER-SIDE ONLY. Never expose to the browser.
# Add your key to .env (never committed):
AI_PROVIDER=openai            # openai | anthropic | custom
AI_API_KEY=
AI_BASE_URL=                  # optional override, e.g. https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Hard budget caps (tokens per request, cost ceiling in cents per day per user)
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_COST_CENTS=100
# D5 kill-switch: live mode stays disabled until explicitly enabled here (server-only)
AI_LIVE_ENABLED=false
